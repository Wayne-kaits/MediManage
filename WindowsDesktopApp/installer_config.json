    "installation": {
        "default_directory": "C:\\Program Files\\Kaitsnet IT Solutions\\Hospital Management System",
        "create_desktop_shortcut": true,
        "create_startmenu_shortcut": true,
        "register_in_programs": true,
        "create_uninstaller": true,
        "check_dependencies": true,
        "auto_start_after_install": false
    },
    "dependencies": {
        "python_packages": [
            {
                "name": "tkcalendar",
                "version": "1.6.1",
                "description": "Calendar widget for Tkinter"
            },
            {
                "name": "matplotlib",
                "version": "3.7.2",
                "description": "Data visualization and charting"
            },
            {
                "name": "pandas",
                "version": "2.0.3",
                "description": "Data analysis and manipulation"
            },
            {
                "name": "Pillow",
                "version": "10.0.0",
                "description": "Image processing library"
            }
        ],
        "optional_packages": [
            {
                "name": "pywin32",
                "description": "Windows-specific functionality"
            },
            {
                "name": "winshell",
                "description": "Windows shell operations"
            }
        ]
    },
    "features": [
