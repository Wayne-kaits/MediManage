            "category": "Core"
        },
        {
            "name": "Billing System",
            "description": "Comprehensive invoicing and payment tracking",
            "category": "Core"
        },
        {
            "name": "Lab Test Management",
            "description": "Test ordering, results, and reporting",
            "category": "Core"
        },
        {
            "name": "Reports & Analytics",
            "description": "Charts and data visualization",
            "category": "Advanced"
        },
        {
            "name": "User Management",
            "description": "Role-based access control",
            "category": "Advanced"
        },
        {
            "name": "Modern UI",
            "description": "Dark theme with professional design",
            "category": "Interface"
        },
        {
            "name": "Data Export",
            "description": "Export reports to various formats",
            "category": "Advanced"
