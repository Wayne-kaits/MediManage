        "minimum_python": "3.7.0",
        "recommended_python": "3.9.0",
        "minimum_ram_mb": 4096,
        "recommended_ram_mb": 8192,
        "minimum_disk_mb": 100,
        "recommended_disk_mb": 500,
        "minimum_resolution": "1366x768",
        "recommended_resolution": "1920x1080"
